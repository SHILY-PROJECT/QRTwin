<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:QRTwin.Maui.ViewModels"
             xmlns:controls="clr-namespace:QRTwin.Maui.Controls"
             xmlns:helpers="clr-namespace:QRTwin.Maui.Helpers"
             x:Class="QRTwin.Maui.Views.GenerateView"
             x:DataType="vm:GenerateViewModel"
             HorizontalOptions="Fill"
             VerticalOptions="Fill">

  <ScrollView Orientation="Vertical"
              VerticalScrollBarVisibility="Default"
              HorizontalOptions="Fill"
              VerticalOptions="Fill">
    <VerticalStackLayout Padding="0,4,0,16"
                         Spacing="16"
                         VerticalOptions="Fill">

      <Label Text="{Binding ErrorMessage}"
             IsVisible="{Binding ErrorMessage, Converter={StaticResource IsStringNotNullOrEmptyConverter}}"
             TextColor="{StaticResource Danger}"
             HorizontalTextAlignment="Center"
             FontSize="14" />

      <ActivityIndicator IsRunning="{Binding IsGenerating}"
                         IsVisible="{Binding IsGenerating}"
                         Color="{StaticResource Accent}"
                         HeightRequest="48"
                         HorizontalOptions="Center" />

      <!-- Empty state -->
      <Border Style="{StaticResource GlassCard}"
              IsVisible="{Binding HasQrCode, Converter={StaticResource InvertedBoolConverter}}"
              VerticalOptions="Center"
              MinimumHeightRequest="280">
        <VerticalStackLayout Spacing="16"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Padding="16">
          <Border WidthRequest="80"
                  HeightRequest="80"
                  StrokeShape="RoundRectangle 24"
                  BackgroundColor="{StaticResource AccentSoft}">
            <controls:SvgIconView IconName="{x:Static helpers:IconPaths.Generate}"
                                  IconColor="{StaticResource Accent}"
                                  WidthRequest="40"
                                  HeightRequest="40"
                                  HorizontalOptions="Center"
                                  VerticalOptions="Center" />
          </Border>
          <Label Text="Создайте QR-код"
                 Style="{StaticResource HeaderLabel}"
                 HorizontalTextAlignment="Center" />
          <Label Text="Введите текст или ссылку в поле ниже и нажмите кнопку генерации"
                 Style="{StaticResource SubtitleLabel}"
                 HorizontalTextAlignment="Center"
                 LineBreakMode="WordWrap"
                 MaximumWidthRequest="320" />
        </VerticalStackLayout>
      </Border>

      <!-- QR result -->
      <Border Style="{StaticResource Card}"
              IsVisible="{Binding HasQrCode}"
              HorizontalOptions="Center"
              Stroke="{StaticResource Accent}"
              StrokeThickness="1.5"
              x:Name="QrCard"
              MaximumWidthRequest="400">
        <VerticalStackLayout Spacing="20" HorizontalOptions="Center">
          <Label Text="Ваш QR-код"
                 Style="{StaticResource HeaderLabel}"
                 HorizontalTextAlignment="Center" />

          <Border BackgroundColor="#FFFFFF"
                  StrokeShape="RoundRectangle 16"
                  Padding="12"
                  HorizontalOptions="Center">
            <Image Source="{Binding QrCodeImage}"
                   WidthRequest="{OnPlatform WinUI=280, Default=240}"
                   HeightRequest="{OnPlatform WinUI=280, Default=240}"
                   Aspect="AspectFit" />
          </Border>

          <Grid ColumnDefinitions="*,*"
                ColumnSpacing="12"
                HorizontalOptions="Fill">
            <Border Grid.Column="0"
                    BackgroundColor="{StaticResource AccentSoft}"
                    Stroke="{StaticResource Border}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="16,14">
              <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ShareCommand}" />
              </Border.GestureRecognizers>
              <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                <controls:SvgIconView IconName="{x:Static helpers:IconPaths.Share}"
                                      IconColor="{StaticResource Accent}"
                                      WidthRequest="20"
                                      HeightRequest="20" />
                <Label Text="Поделиться"
                       TextColor="{StaticResource PrimaryText}"
                       FontSize="14"
                       FontAttributes="Bold"
                       VerticalOptions="Center" />
              </HorizontalStackLayout>
            </Border>

            <Border Grid.Column="1"
                    Background="{StaticResource AccentGradientBrush}"
                    StrokeShape="RoundRectangle 16"
                    Padding="16,14">
              <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding SaveCommand}" />
              </Border.GestureRecognizers>
              <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                <controls:SvgIconView IconName="{x:Static helpers:IconPaths.Save}"
                                      IconColor="#FFFFFF"
                                      WidthRequest="20"
                                      HeightRequest="20" />
                <Label Text="Сохранить"
                       TextColor="#FFFFFF"
                       FontSize="14"
                       FontAttributes="Bold"
                       VerticalOptions="Center" />
              </HorizontalStackLayout>
            </Border>
          </Grid>

          <Button Text="Сбросить"
                  Style="{StaticResource SecondaryButton}"
                  TextColor="{StaticResource Danger}"
                  Margin="0,4,0,0"
                  Clicked="OnResetQrClicked" />
        </VerticalStackLayout>
      </Border>
    </VerticalStackLayout>
  </ScrollView>
</ContentView>
