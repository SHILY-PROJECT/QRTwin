<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:QRTwin.Maui.ViewModels"
             xmlns:controls="clr-namespace:QRTwin.Maui.Controls"
             xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls"
             xmlns:helpers="clr-namespace:QRTwin.Maui.Helpers"
             x:Class="QRTwin.Maui.Views.ScanView"
             x:DataType="vm:ScanViewModel"
             HorizontalOptions="Fill"
             VerticalOptions="Fill">

  <Grid RowDefinitions="*,Auto" RowSpacing="12">

    <!-- Scanner area -->
    <Border Grid.Row="0"
            Style="{StaticResource GlassCard}"
            Padding="0"
            Stroke="{StaticResource Accent}"
            StrokeThickness="1.5">
      <Grid RowDefinitions="Auto,*">

        <Label Grid.Row="0"
               Text="Наведите камеру на QR-код"
               Style="{StaticResource SubtitleLabel}"
               HorizontalTextAlignment="Center"
               Margin="0,16,0,8" />

        <Grid Grid.Row="1"
              MinimumHeightRequest="280"
              VerticalOptions="Fill">

          <!-- No permission / error state -->
          <VerticalStackLayout IsVisible="{Binding HasCameraPermission, Converter={StaticResource InvertedBoolConverter}}"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"
                               Spacing="16"
                               Padding="24">
            <Border WidthRequest="72"
                    HeightRequest="72"
                    StrokeShape="RoundRectangle 20"
                    BackgroundColor="{StaticResource AccentSoft}">
              <controls:SvgIconView IconName="{x:Static helpers:IconPaths.Scan}"
                                    IconColor="{StaticResource Accent}"
                                    WidthRequest="36"
                                    HeightRequest="36"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
            </Border>
            <Label Text="{Binding ErrorMessage}"
                   TextColor="{StaticResource SecondaryText}"
                   FontSize="15"
                   HorizontalTextAlignment="Center"
                   LineBreakMode="WordWrap" />
            <Button Text="Разрешить камеру"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding InitializeCommand}"
                    HorizontalOptions="Center" />
          </VerticalStackLayout>

          <!-- Scanner frame -->
          <Border x:Name="ScannerFrame"
                  IsVisible="{Binding HasCameraPermission}"
                  HorizontalOptions="Center"
                  VerticalOptions="Center"
                  WidthRequest="{OnPlatform WinUI=360, Default=300}"
                  HeightRequest="{OnPlatform WinUI=360, Default=300}"
                  Background="Transparent"
                  Stroke="{StaticResource Accent}"
                  StrokeThickness="2"
                  StrokeShape="RoundRectangle 24">
            <Grid>
              <zxing:CameraBarcodeReaderView x:Name="BarcodeReader"
                                             BarcodesDetected="OnBarcodesDetected"
                                             IsDetecting="{Binding IsScanning}"
                                             IsTorchOn="False"
                                             Opacity="0"
                                             WidthRequest="1"
                                             HeightRequest="1"
                                             HorizontalOptions="Start"
                                             VerticalOptions="Start"
                                             InputTransparent="True" />

              <VerticalStackLayout Spacing="12"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Center"
                                   Padding="20"
                                   IsVisible="{Binding HasResult, Converter={StaticResource InvertedBoolConverter}}">
                <Label Text="Пример QR-кода"
                       Style="{StaticResource SubtitleLabel}"
                       HorizontalTextAlignment="Center"
                       FontSize="13" />

                <Grid x:Name="QrScanArea"
                      WidthRequest="{OnPlatform WinUI=220, Default=200}"
                      HeightRequest="{OnPlatform WinUI=220, Default=200}"
                      HorizontalOptions="Center">
                  <Border BackgroundColor="#FFFFFF"
                          StrokeShape="RoundRectangle 16"
                          Padding="10"
                          HorizontalOptions="Fill"
                          VerticalOptions="Fill">
                    <Image x:Name="SampleQrImage"
                           Source="{Binding SampleQrCodeImage}"
                           Aspect="AspectFit"
                           HorizontalOptions="Fill"
                           VerticalOptions="Fill" />
                  </Border>

                  <Border StrokeThickness="0"
                          BackgroundColor="#22000000"
                          StrokeShape="RoundRectangle 16"
                          HorizontalOptions="Fill"
                          VerticalOptions="Fill"
                          InputTransparent="True">
                    <BoxView x:Name="ScanLine"
                             Color="{StaticResource ScannerLine}"
                             HeightRequest="2"
                             HorizontalOptions="Fill"
                             VerticalOptions="Start"
                             Margin="12,0"
                             Opacity="0.9"
                             InputTransparent="True" />
                  </Border>
                </Grid>

                <Label Text="Наведите камеру на любой QR-код"
                       TextColor="{StaticResource MutedText}"
                       FontSize="12"
                       HorizontalTextAlignment="Center" />
              </VerticalStackLayout>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Border>

    <!-- Result card -->
    <Border Grid.Row="1"
            Style="{StaticResource Card}"
            IsVisible="{Binding HasResult}"
            Stroke="{StaticResource Accent}"
            StrokeThickness="1">
      <Grid ColumnDefinitions="*,Auto"
            RowDefinitions="Auto,Auto,Auto"
            ColumnSpacing="12"
            RowSpacing="4">
        <Label Grid.Row="0"
               Grid.Column="0"
               Grid.ColumnSpan="2"
               Text="Результат"
               Style="{StaticResource HeaderLabel}"
               FontSize="16" />

        <Label Grid.Row="1"
               Grid.Column="0"
               Text="{Binding ScanResult}"
               TextColor="{StaticResource Accent}"
               FontSize="15"
               LineBreakMode="WordWrap">
          <Label.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding OpenUrlCommand}" />
          </Label.GestureRecognizers>
          <Label.Triggers>
            <DataTrigger TargetType="Label"
                         Binding="{Binding IsUrl}"
                         Value="False">
              <Setter Property="TextColor" Value="{StaticResource PrimaryText}" />
            </DataTrigger>
          </Label.Triggers>
        </Label>

        <Border Grid.Row="1"
                Grid.Column="1"
                Style="{StaticResource IconButton}"
                BackgroundColor="{StaticResource AccentSoft}">
          <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding CopyResultCommand}" />
          </Border.GestureRecognizers>
          <controls:SvgIconView IconName="{x:Static helpers:IconPaths.Copy}"
                                IconColor="{StaticResource Accent}" />
        </Border>

        <Button Grid.Row="2"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Text="Сканировать снова"
                Style="{StaticResource SecondaryButton}"
                Margin="0,8,0,0"
                Command="{Binding ResetScanCommand}" />
      </Grid>
    </Border>
  </Grid>
</ContentView>
