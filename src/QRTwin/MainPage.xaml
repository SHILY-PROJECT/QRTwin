<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:QRTwin.ViewModels"
             xmlns:views="clr-namespace:QRTwin.Views"
             xmlns:controls="clr-namespace:QRTwin.Controls"
             xmlns:helpers="clr-namespace:QRTwin.Helpers"
             x:Class="QRTwin.MainPage"
             x:Name="MainPageRoot"
             x:DataType="vm:MainViewModel"
             Shell.NavBarIsVisible="False"
             Background="{DynamicResource PageBackgroundBrush}">

  <Grid x:Name="RootLayout"
        RowDefinitions="Auto,*,Auto,Auto"
        SafeAreaEdges="All">

    <!-- Background glow -->
    <BoxView Grid.RowSpan="4"
             InputTransparent="True"
             Background="{DynamicResource BackgroundGlowBrush}" />

    <!-- Header -->
    <Grid Grid.Row="0"
          Padding="20,16,20,8"
          ColumnDefinitions="Auto,*,Auto"
          ColumnSpacing="12">
      <Border WidthRequest="44"
              HeightRequest="44"
              StrokeShape="RoundRectangle 14"
              Background="{DynamicResource AccentGradientBrush}">
        <controls:SvgIconView IconName="{x:Static helpers:IconPaths.Generate}"
                              IconColor="#FFFFFF"
                              WidthRequest="22"
                              HeightRequest="22"
                              HorizontalOptions="Center"
                              VerticalOptions="Center" />
      </Border>

      <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
        <Label Text="QRTwin"
               FontSize="22"
               FontAttributes="Bold"
               TextColor="{DynamicResource PrimaryText}" />
        <Label Text="Сканируйте и создавайте QR-коды"
               Style="{StaticResource CaptionLabel}" />
      </VerticalStackLayout>

      <HorizontalStackLayout Grid.Column="2"
                             Spacing="8"
                             HorizontalOptions="End"
                             VerticalOptions="Center">
        <Border Style="{StaticResource IconButton}">
          <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding OpenThemesCommand}" />
          </Border.GestureRecognizers>
          <controls:SvgIconView IconName="{x:Static helpers:IconPaths.Themes}"
                                IconColor="{DynamicResource Accent}" />
        </Border>

        <Border Style="{StaticResource AccentIconButton}">
          <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding OpenHistoryCommand}" />
          </Border.GestureRecognizers>
          <controls:SvgIconView IconName="{x:Static helpers:IconPaths.History}"
                                IconColor="#FFFFFF" />
        </Border>
      </HorizontalStackLayout>
    </Grid>

    <!-- Main content area -->
    <Grid Grid.Row="1"
          x:Name="ContentHost"
          Padding="16,8"
          RowDefinitions="*"
          MaximumWidthRequest="720"
          HorizontalOptions="Fill">

      <Grid x:Name="ScanPanel"
            IsVisible="{Binding SelectedTab, Converter={StaticResource AppTabToBoolConverter}, ConverterParameter=Scan}">
        <views:ScanView x:Name="ScanContent"
                        BindingContext="{Binding Scan}"
                        HorizontalOptions="Fill"
                        VerticalOptions="Fill" />
      </Grid>

      <Grid x:Name="GeneratePanel"
            IsVisible="{Binding SelectedTab, Converter={StaticResource AppTabToBoolConverter}, ConverterParameter=Generate}">
        <views:GenerateView x:Name="GenerateContent"
                            BindingContext="{Binding Generate}"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill" />
      </Grid>
    </Grid>

    <!-- Generate input bar -->
    <Border x:Name="GenerateInputBar"
            Grid.Row="2"
            Margin="16,4,16,8"
            Padding="6"
            BackgroundColor="{DynamicResource Surface}"
            Stroke="{DynamicResource Border}"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 20"
            MaximumWidthRequest="720"
            HorizontalOptions="Fill"
            IsVisible="{Binding SelectedTab, Converter={StaticResource AppTabToBoolConverter}, ConverterParameter=Generate}">
      <VerticalStackLayout Spacing="0">
        <Editor x:Name="GenerateInputEditor"
                Style="{StaticResource InputEditor}"
                Margin="12,4,12,0"
                HeightRequest="44"
                BackgroundColor="Transparent"
                Placeholder="Введите текст или ссылку..."
                Text="{Binding Generate.InputText}"
                Focused="OnGenerateInputEditorFocused"
                Unfocused="OnGenerateInputEditorUnfocused"
                Completed="OnGenerateInputEditorCompleted" />

        <BoxView x:Name="InputEditorSeparator"
                 HeightRequest="1"
                 Margin="12,8,12,8"
                 HorizontalOptions="Fill"
                 Color="{DynamicResource Border}" />

        <Grid ColumnDefinitions="8*,2*"
              ColumnSpacing="8"
              HorizontalOptions="Fill">
          <Border x:Name="ImageGenButton"
                  Grid.Column="0"
                  StrokeShape="RoundRectangle 16"
                  HeightRequest="44"
                  HorizontalOptions="Fill">
            <Border.GestureRecognizers>
              <TapGestureRecognizer Tapped="OnImageGenTapped" />
            </Border.GestureRecognizers>
            <controls:SvgIconView x:Name="ImageGenIcon"
                                  IconName="{x:Static helpers:IconPaths.Image}"
                                  HorizontalOptions="Center"
                                  VerticalOptions="Center"
                                  InputTransparent="True" />
          </Border>

          <Border x:Name="WandButton"
                  Grid.Column="1"
                  StrokeShape="RoundRectangle 16"
                  HeightRequest="44"
                  HorizontalOptions="Fill">
            <Border.GestureRecognizers>
              <TapGestureRecognizer Tapped="OnWandTapped" />
            </Border.GestureRecognizers>
            <controls:SvgIconView x:Name="WandIcon"
                                  IconName="{x:Static helpers:IconPaths.Wand}"
                                  HorizontalOptions="Center"
                                  VerticalOptions="Center"
                                  InputTransparent="True" />
          </Border>
        </Grid>
      </VerticalStackLayout>
    </Border>

    <!-- Bottom tab bar -->
    <Border x:Name="BottomTabBar"
            Grid.Row="3"
            Margin="16,0,16,20"
            Padding="4"
            BackgroundColor="{DynamicResource Surface}"
            Stroke="{DynamicResource Border}"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 24"
            MaximumWidthRequest="720"
            HorizontalOptions="Fill">
      <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
        <Border x:Name="ScanTab"
                Style="{StaticResource TabPill}">
          <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnScanTabTapped" />
          </Border.GestureRecognizers>
          <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
            <controls:SvgIconView x:Name="ScanTabIcon"
                                  IconName="{x:Static helpers:IconPaths.Scan}"
                                  WidthRequest="20"
                                  HeightRequest="20" />
            <Label Text="Сканировать"
                   FontSize="14"
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   x:Name="ScanTabLabel" />
          </HorizontalStackLayout>
        </Border>

        <Border Grid.Column="1"
                x:Name="GenerateTab"
                Style="{StaticResource TabPill}">
          <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnGenerateTabTapped" />
          </Border.GestureRecognizers>
          <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
            <controls:SvgIconView x:Name="GenerateTabIcon"
                                  IconName="{x:Static helpers:IconPaths.Generate}"
                                  WidthRequest="20"
                                  HeightRequest="20" />
            <Label Text="Генерировать"
                   FontSize="14"
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   x:Name="GenerateTabLabel" />
          </HorizontalStackLayout>
        </Border>
      </Grid>
    </Border>

    <!-- History overlay -->
    <Grid Grid.RowSpan="4"
          IsVisible="{Binding IsHistoryVisible}"
          ZIndex="100">
      <BoxView BackgroundColor="#E6000000">
        <BoxView.GestureRecognizers>
          <TapGestureRecognizer Command="{Binding CloseHistoryCommand}" />
        </BoxView.GestureRecognizers>
      </BoxView>

      <Grid Padding="20,48,20,24"
            MaximumWidthRequest="640"
            HorizontalOptions="Fill"
            VerticalOptions="Fill">
        <Border Style="{StaticResource GlassCard}"
                VerticalOptions="Fill"
                HorizontalOptions="Fill">
          <Grid RowDefinitions="Auto,*"
                RowSpacing="8">
            <Grid Grid.Row="0"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="12">
              <Label Text="История"
                     Style="{StaticResource TitleLabel}"
                     FontSize="20"
                     VerticalOptions="Center"
                     LineBreakMode="TailTruncation" />
              <Border Grid.Column="1"
                      BackgroundColor="{DynamicResource SurfaceElevated}"
                      StrokeShape="RoundRectangle 12"
                      Padding="12,8"
                      HorizontalOptions="End"
                      VerticalOptions="Center">
                <Border.GestureRecognizers>
                  <TapGestureRecognizer Command="{Binding CloseHistoryCommand}" />
                </Border.GestureRecognizers>
                <Label Text="Закрыть"
                       TextColor="{DynamicResource Accent}"
                       FontAttributes="Bold"
                       FontSize="14"
                       LineBreakMode="NoWrap" />
              </Border>
            </Grid>

            <views:HistoryView Grid.Row="1"
                               BindingContext="{Binding History}"
                               HorizontalOptions="Fill"
                               VerticalOptions="Fill" />
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <!-- Themes overlay -->
    <Grid Grid.RowSpan="4"
          IsVisible="{Binding IsThemesVisible}"
          ZIndex="101">
      <BoxView BackgroundColor="#E6000000">
        <BoxView.GestureRecognizers>
          <TapGestureRecognizer Command="{Binding CloseThemesCommand}" />
        </BoxView.GestureRecognizers>
      </BoxView>

      <Grid Padding="20,48,20,24"
            MaximumWidthRequest="640"
            HorizontalOptions="Fill"
            VerticalOptions="Fill">
        <Border Style="{StaticResource GlassCard}"
                VerticalOptions="Fill"
                HorizontalOptions="Fill">
          <Grid RowDefinitions="Auto,*"
                RowSpacing="8">
            <Grid Grid.Row="0"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="12">
              <Label Text="Темы"
                     Style="{StaticResource TitleLabel}"
                     FontSize="20"
                     VerticalOptions="Center"
                     LineBreakMode="TailTruncation" />
              <Border Grid.Column="1"
                      BackgroundColor="{DynamicResource SurfaceElevated}"
                      StrokeShape="RoundRectangle 12"
                      Padding="12,8"
                      HorizontalOptions="End"
                      VerticalOptions="Center">
                <Border.GestureRecognizers>
                  <TapGestureRecognizer Command="{Binding CloseThemesCommand}" />
                </Border.GestureRecognizers>
                <Label Text="Закрыть"
                       TextColor="{DynamicResource Accent}"
                       FontAttributes="Bold"
                       FontSize="14"
                       LineBreakMode="NoWrap" />
              </Border>
            </Grid>

            <views:ThemesView Grid.Row="1"
                              BindingContext="{Binding Themes}"
                              HorizontalOptions="Fill"
                              VerticalOptions="Fill" />
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>

  <VisualStateManager.VisualStateGroups>
    <VisualStateGroupList>
      <VisualStateGroup x:Name="WindowSizeStates">
        <VisualState x:Name="Narrow">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="0" />
          </VisualState.StateTriggers>
        </VisualState>
        <VisualState x:Name="Wide">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="900" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter TargetName="ContentHost" Property="Padding" Value="24,12" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateGroupList>
  </VisualStateManager.VisualStateGroups>
</ContentPage>
