<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:QRTwin.ViewModels"
             xmlns:views="clr-namespace:QRTwin.Views"
             xmlns:controls="clr-namespace:QRTwin.Controls"
             xmlns:helpers="clr-namespace:QRTwin.Helpers"
             xmlns:effects="clr-namespace:QRTwin.Effects"
             xmlns:themes="clr-namespace:QRTwin.Themes"
             x:Class="QRTwin.MainPage"
             x:Name="MainPageRoot"
             x:DataType="vm:MainViewModel"
             Shell.NavBarIsVisible="False"
             Background="{DynamicResource PageBackgroundBrush}">

  <Grid x:Name="RootLayout"
        RowDefinitions="Auto,*,Auto"
        SafeAreaEdges="All">

    <!-- Background glow -->
    <BoxView Grid.RowSpan="3"
             InputTransparent="True"
             Background="{DynamicResource BackgroundGlowBrush}" />
    <BoxView x:Name="BackgroundGlowSecondary"
             Grid.RowSpan="3"
             InputTransparent="True"
             Background="{DynamicResource BackgroundGlowSecondaryBrush}" />

    <!-- Header -->
    <Grid Grid.Row="0"
          Padding="20,16,20,8"
          ColumnDefinitions="Auto,*,Auto"
          ColumnSpacing="12">
      <Border WidthRequest="44"
              HeightRequest="44"
              StrokeShape="RoundRectangle 10"
              Background="{DynamicResource AccentGradientBrush}"
              effects:GlassEffect.Intensity="{x:Static themes:GlassEffectIntensity.Normal}">
        <controls:SvgIconView IconName="{x:Static helpers:IconPaths.Generate}"
                              IconColor="#FFFFFF"
                              WidthRequest="40"
                              HeightRequest="40"
                              HorizontalOptions="Center"
                              VerticalOptions="Center" />
      </Border>

      <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
        <Label Text="QRTwin"
               FontSize="22"
               FontAttributes="Bold"
               TextColor="{DynamicResource PrimaryText}" />
        <HorizontalStackLayout Spacing="0" VerticalOptions="Center">
          <Label Text="Сканируйте и создавайте QR-коды | "
                 Style="{StaticResource CaptionLabel}" />
          <Label x:Name="AuthorCreditLabel"
                 Text=" by MrSHILY"
                 Style="{StaticResource CaptionLabel}"
                 Padding="0,0,4,0">
            <Label.GestureRecognizers>
              <TapGestureRecognizer Tapped="OnAuthorCreditTapped" />
            </Label.GestureRecognizers>
          </Label>
        </HorizontalStackLayout>
      </VerticalStackLayout>

      <HorizontalStackLayout Grid.Column="2"
                             Spacing="8"
                             HorizontalOptions="End"
                             VerticalOptions="Center">
        <Border x:Name="ThemesHeaderButton"
                Style="{StaticResource IconButton}">
          <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding OpenThemesCommand}" />
          </Border.GestureRecognizers>
          <controls:SvgIconView x:Name="ThemesHeaderIcon"
                                IconName="{x:Static helpers:IconPaths.Themes}"
                                IconColor="{DynamicResource Accent}" />
        </Border>

        <Border x:Name="HistoryHeaderButton"
                Style="{StaticResource AccentIconButton}">
          <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding OpenHistoryCommand}" />
          </Border.GestureRecognizers>
          <controls:SvgIconView x:Name="HistoryHeaderIcon"
                                IconName="{x:Static helpers:IconPaths.History}"
                                IconColor="#FFFFFF" />
        </Border>
      </HorizontalStackLayout>
    </Grid>

    <!-- Duplicate generate toast -->
    <Border x:Name="DuplicateQrToast"
            Grid.Row="0"
            Grid.RowSpan="3"
            Style="{StaticResource GlassCard}"
            Stroke="{DynamicResource Accent}"
            StrokeThickness="1.5"
            Margin="16,12"
            Padding="16,12"
            MaximumWidthRequest="720"
            HorizontalOptions="Fill"
            VerticalOptions="Start"
            ZIndex="200"
            IsVisible="False"
            Opacity="0"
            InputTransparent="True"
            TranslationY="-12">
      <Label x:Name="DuplicateQrToastLabel"
             Text="Вы только что сгенерировали такой QR-код"
             TextColor="{DynamicResource PrimaryText}"
             FontSize="14"
             FontAttributes="Bold"
             HorizontalTextAlignment="Center"
             LineBreakMode="WordWrap" />
    </Border>

    <!-- Main content area + floating generate input -->
    <Grid x:Name="ContentAreaGrid"
          Grid.Row="1"
          MaximumWidthRequest="720"
          HorizontalOptions="Fill">

      <Grid x:Name="ContentHost"
            Padding="16,8"
            RowDefinitions="*">

        <Grid x:Name="ScanPanel">
          <views:ScanView x:Name="ScanContent"
                          BindingContext="{Binding Scan}"
                          HorizontalOptions="Fill"
                          VerticalOptions="Fill" />
        </Grid>

        <Grid x:Name="GeneratePanel">
          <views:GenerateView x:Name="GenerateContent"
                              BindingContext="{Binding Generate}"
                              HorizontalOptions="Fill"
                              VerticalOptions="Fill" />
        </Grid>
      </Grid>

      <Border x:Name="GenerateInputBar"
              Style="{StaticResource GlassCard}"
              Margin="16,0,16,8"
              Padding="6"
              HorizontalOptions="Fill"
              VerticalOptions="End"
              ZIndex="10"
              IsVisible="False"
              Opacity="0"
              InputTransparent="True">
        <VerticalStackLayout Spacing="0">
          <Editor x:Name="GenerateInputEditor"
                  Style="{StaticResource InputEditor}"
                  Margin="0,4,0,0"
                  HeightRequest="44"
                  BackgroundColor="Transparent"
                  Placeholder="Введите текст или ссылку..."
                  Text="{Binding Generate.InputText}"
                  Focused="OnGenerateInputEditorFocused"
                  Unfocused="OnGenerateInputEditorUnfocused"
                  Completed="OnGenerateInputEditorCompleted" />

          <BoxView x:Name="InputEditorSeparator"
                   HeightRequest="1.5"
                   Margin="0,8"
                   HorizontalOptions="Fill"
                   Color="{DynamicResource BorderLight}" />

          <Grid ColumnDefinitions="8*,2*"
                ColumnSpacing="8"
                HorizontalOptions="Fill">
            <Border x:Name="ImageGenButton"
                    Grid.Column="0"
                    Style="{StaticResource GlassCardButton}">
              <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnImageGenTapped" />
              </Border.GestureRecognizers>
              <Grid>
                <BoxView x:Name="ImageGenButtonGlow"
                         Color="{DynamicResource Accent}"
                         CornerRadius="10"
                         Opacity="0"
                         InputTransparent="True"
                         HorizontalOptions="Fill"
                         VerticalOptions="Fill" />
                <controls:SvgIconView x:Name="ImageGenIcon"
                                      IconName="{x:Static helpers:IconPaths.Image}"
                                      IconColor="{DynamicResource MutedText}"
                                      WidthRequest="24"
                                      HeightRequest="24"
                                      HorizontalOptions="Center"
                                      VerticalOptions="Center"
                                      InputTransparent="True" />
                <controls:SvgIconView x:Name="ImageGenIconLit"
                                      IconName="{x:Static helpers:IconPaths.Image}"
                                      IconColor="White"
                                      Opacity="0"
                                      WidthRequest="24"
                                      HeightRequest="24"
                                      HorizontalOptions="Center"
                                      VerticalOptions="Center"
                                      InputTransparent="True" />
              </Grid>
            </Border>

            <Border x:Name="WandButton"
                    Grid.Column="1"
                    Style="{StaticResource GlassCardButton}">
              <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnWandTapped" />
              </Border.GestureRecognizers>
              <Grid>
                <BoxView x:Name="WandButtonGlow"
                         Color="{DynamicResource Accent}"
                         CornerRadius="10"
                         Opacity="0"
                         InputTransparent="True"
                         HorizontalOptions="Fill"
                         VerticalOptions="Fill" />
                <controls:SvgIconView x:Name="WandIcon"
                                      IconName="{x:Static helpers:IconPaths.Wand}"
                                      IconColor="{DynamicResource MutedText}"
                                      WidthRequest="24"
                                      HeightRequest="24"
                                      HorizontalOptions="Center"
                                      VerticalOptions="Center"
                                      InputTransparent="True" />
                <controls:SvgIconView x:Name="WandIconLit"
                                      IconName="{x:Static helpers:IconPaths.Wand}"
                                      IconColor="White"
                                      Opacity="0"
                                      WidthRequest="24"
                                      HeightRequest="24"
                                      HorizontalOptions="Center"
                                      VerticalOptions="Center"
                                      InputTransparent="True" />
              </Grid>
            </Border>
          </Grid>
        </VerticalStackLayout>
      </Border>
    </Grid>

    <!-- Bottom tab bar -->
    <Border x:Name="BottomTabBar"
            Grid.Row="2"
            Style="{StaticResource GlassChromeBar}"
            Margin="16,0,16,20"
            Padding="4"
            StrokeShape="RoundRectangle 10"
            MaximumWidthRequest="720"
            HorizontalOptions="Fill">
      <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
        <Border x:Name="ScanTab"
                Style="{StaticResource TabPill}">
          <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnScanTabTapped" />
          </Border.GestureRecognizers>
          <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
            <controls:SvgIconView x:Name="ScanTabIcon"
                                  IconName="{x:Static helpers:IconPaths.Scan}"
                                  WidthRequest="20"
                                  HeightRequest="20" />
            <Label Text="Сканировать"
                   FontSize="14"
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   x:Name="ScanTabLabel" />
          </HorizontalStackLayout>
        </Border>

        <Border Grid.Column="1"
                x:Name="GenerateTab"
                Style="{StaticResource TabPill}">
          <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnGenerateTabTapped" />
          </Border.GestureRecognizers>
          <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
            <controls:SvgIconView x:Name="GenerateTabIcon"
                                  IconName="{x:Static helpers:IconPaths.Generate}"
                                  WidthRequest="20"
                                  HeightRequest="20" />
            <Label Text="Генерировать"
                   FontSize="14"
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   x:Name="GenerateTabLabel" />
          </HorizontalStackLayout>
        </Border>
      </Grid>
    </Border>

    <!-- History overlay -->
    <Grid x:Name="HistoryOverlay"
          Grid.RowSpan="3"
          IsVisible="False"
          InputTransparent="True"
          ZIndex="100">
      <BoxView x:Name="HistoryOverlayScrim"
               Opacity="0"
               Background="{DynamicResource OverlayScrimBrush}">
        <BoxView.GestureRecognizers>
          <TapGestureRecognizer Command="{Binding CloseHistoryCommand}" />
        </BoxView.GestureRecognizers>
      </BoxView>

      <Grid Padding="20,48,20,24"
            MaximumWidthRequest="640"
            HorizontalOptions="Fill"
            VerticalOptions="Fill">
        <Border x:Name="HistoryOverlayPanel"
                Style="{StaticResource GlassOverlayCard}"
                VerticalOptions="Fill"
                HorizontalOptions="Fill">
          <Grid RowDefinitions="Auto,*"
                RowSpacing="0">
            <Grid Grid.Row="0"
                  Padding="20,20,20,12"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="12">
              <Label Text="История"
                     Style="{StaticResource TitleLabel}"
                     FontSize="20"
                     VerticalOptions="Center"
                     LineBreakMode="TailTruncation" />
              <Border Grid.Column="1"
                      Style="{StaticResource OverlayCloseButton}">
                <Border.GestureRecognizers>
                  <TapGestureRecognizer Command="{Binding CloseHistoryCommand}" />
                </Border.GestureRecognizers>
                <controls:SvgIconView IconName="{x:Static helpers:IconPaths.Close}"
                                      IconColor="#FFFFFF"
                                      WidthRequest="18"
                                      HeightRequest="18"
                                      HorizontalOptions="Center"
                                      VerticalOptions="Center"
                                      InputTransparent="True" />
              </Border>
            </Grid>

            <views:HistoryView Grid.Row="1"
                               BindingContext="{Binding History}"
                               HorizontalOptions="Fill"
                               VerticalOptions="Fill" />
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <!-- Themes overlay -->
    <Grid x:Name="ThemesOverlay"
          Grid.RowSpan="3"
          IsVisible="False"
          InputTransparent="True"
          ZIndex="101">
      <BoxView x:Name="ThemesOverlayScrim"
               Opacity="0"
               Background="{DynamicResource OverlayScrimBrush}">
        <BoxView.GestureRecognizers>
          <TapGestureRecognizer Command="{Binding CloseThemesCommand}" />
        </BoxView.GestureRecognizers>
      </BoxView>

      <Grid Padding="20,48,20,24"
            MaximumWidthRequest="640"
            HorizontalOptions="Fill"
            VerticalOptions="Fill">
        <Border x:Name="ThemesOverlayPanel"
                Style="{StaticResource GlassOverlayCard}"
                VerticalOptions="Fill"
                HorizontalOptions="Fill">
          <Grid RowDefinitions="Auto,*"
                RowSpacing="0">
            <Grid Grid.Row="0"
                  Padding="20,20,20,12"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="12">
              <Label Text="Темы"
                     Style="{StaticResource TitleLabel}"
                     FontSize="20"
                     VerticalOptions="Center"
                     LineBreakMode="TailTruncation" />
              <Border Grid.Column="1"
                      Style="{StaticResource OverlayCloseButton}">
                <Border.GestureRecognizers>
                  <TapGestureRecognizer Command="{Binding CloseThemesCommand}" />
                </Border.GestureRecognizers>
                <controls:SvgIconView IconName="{x:Static helpers:IconPaths.Close}"
                                      IconColor="#FFFFFF"
                                      WidthRequest="18"
                                      HeightRequest="18"
                                      HorizontalOptions="Center"
                                      VerticalOptions="Center"
                                      InputTransparent="True" />
              </Border>
            </Grid>

            <views:ThemesView Grid.Row="1"
                              BindingContext="{Binding Themes}"
                              HorizontalOptions="Fill"
                              VerticalOptions="Fill" />
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>

  <VisualStateManager.VisualStateGroups>
    <VisualStateGroupList>
      <VisualStateGroup x:Name="WindowSizeStates">
        <VisualState x:Name="Narrow">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="0" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter TargetName="BackgroundGlowSecondary" Property="Opacity" Value="1" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="Wide">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="900" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter TargetName="ContentHost" Property="Padding" Value="24,12" />
            <Setter TargetName="BackgroundGlowSecondary" Property="Opacity" Value="0.72" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateGroupList>
  </VisualStateManager.VisualStateGroups>
</ContentPage>
