<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Color x:Key="AppBackground">#121212</Color>
    <Color x:Key="AppBackgroundDeep">#0A0A0A</Color>
    <Color x:Key="Surface">#D91E1E1E</Color>
    <Color x:Key="SurfaceElevated">#D9282828</Color>
    <Color x:Key="SurfaceGlass">#D91E1E1E</Color>
    <Color x:Key="PrimaryText">#FFFFFF</Color>
    <Color x:Key="SecondaryText">#D99E9E9E</Color>
    <Color x:Key="MutedText">#D9666666</Color>
    <Color x:Key="Accent">#FF4D00</Color>
    <Color x:Key="AccentLight">#FF6B2C</Color>
    <Color x:Key="AccentGlow">#40FF4D00</Color>
    <Color x:Key="AccentSoft">#1AFF4D00</Color>
    <Color x:Key="Danger">#FF4444</Color>
    <Color x:Key="Success">#4CAF50</Color>
    <Color x:Key="ScannerLine">#FF4D00</Color>
    <Color x:Key="Border">#D92A2A2A</Color>
    <Color x:Key="BorderLight">#D93A3A3A</Color>
    <Color x:Key="TabActiveBackground">#FF4D00</Color>
    <Color x:Key="TabActiveText">#FFFFFF</Color>
    <Color x:Key="TabActiveIcon">#FFFFFF</Color>
    <Color x:Key="TabInactiveText">#D99E9E9E</Color>
    <Color x:Key="TabInactiveIcon">#D9666666</Color>
    <Color x:Key="TabActiveBorder">#00000000</Color>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackground}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Border}" />

    <SolidColorBrush x:Key="PageBackgroundBrush" Color="{StaticResource AppBackground}" />

    <RadialGradientBrush x:Key="BackgroundGlowBrush" Center="0.5,0.0" Radius="1.4">
        <GradientStop Color="#35FF4D00" Offset="0.0" />
        <GradientStop Color="#18FF4D00" Offset="0.35" />
        <GradientStop Color="#00121212" Offset="1.0" />
    </RadialGradientBrush>

    <SolidColorBrush x:Key="BackgroundGlowSecondaryBrush" Color="Transparent" />

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF4D00" Offset="0.0" />
        <GradientStop Color="#FF6B2C" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CardGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#D9242424" Offset="0.0" />
        <GradientStop Color="#D91A1A1A" Offset="1.0" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="OverlayScrimBrush" Color="#E6000000" />

    <LinearGradientBrush x:Key="OverlayPanelBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#D9242424" Offset="0.0" />
        <GradientStop Color="#D91A1A1A" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="OverlayItemBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#D9282828" Offset="0.0" />
        <GradientStop Color="#D9222222" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ScannerBeamBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00FF4D00" Offset="0.0" />
        <GradientStop Color="#33FF4D00" Offset="0.55" />
        <GradientStop Color="#80FF4D00" Offset="0.85" />
        <GradientStop Color="#FF4D00" Offset="1.0" />
    </LinearGradientBrush>
</ResourceDictionary>
