<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:QRTwin.ViewModels"
             xmlns:controls="clr-namespace:QRTwin.Controls"
             xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls"
             xmlns:helpers="clr-namespace:QRTwin.Helpers"
             x:Class="QRTwin.Views.ScanView"
             x:DataType="vm:ScanViewModel"
             HorizontalOptions="Fill"
             VerticalOptions="Fill">

  <Grid>

    <!-- Scanner area -->
    <Border Style="{StaticResource GlassCard}"
            Padding="0"
            Stroke="{DynamicResource Accent}"
            StrokeThickness="1.5"
            HorizontalOptions="Fill"
            VerticalOptions="Fill">
      <Grid RowDefinitions="Auto,*">

        <Label Grid.Row="0"
               Text="Наведите камеру на QR-код"
               Style="{StaticResource SubtitleLabel}"
               HorizontalTextAlignment="Center"
               Margin="0,16,12,8"
               LineBreakMode="WordWrap" />

        <Grid x:Name="ScannerHost"
              Grid.Row="1"
              Padding="12,0,12,12"
              VerticalOptions="Fill"
              HorizontalOptions="Fill">

          <!-- No permission / error state -->
          <VerticalStackLayout IsVisible="{Binding HasCameraPermission, Converter={StaticResource InvertedBoolConverter}}"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"
                               Spacing="16"
                               Padding="24"
                               MaximumWidthRequest="420">
            <Border WidthRequest="72"
                    HeightRequest="72"
                    StrokeShape="RoundRectangle 10"
                    BackgroundColor="{DynamicResource AccentSoft}"
                    HorizontalOptions="Center">
              <controls:SvgIconView IconName="{x:Static helpers:IconPaths.Scan}"
                                    IconColor="{DynamicResource Accent}"
                                    WidthRequest="36"
                                    HeightRequest="36"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />
            </Border>
            <Label Text="{Binding ErrorMessage}"
                   TextColor="{DynamicResource SecondaryText}"
                   FontSize="15"
                   HorizontalTextAlignment="Center"
                   LineBreakMode="WordWrap" />
            <Button Text="Разрешить камеру"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding InitializeCommand}"
                    HorizontalOptions="Center" />
          </VerticalStackLayout>

          <!-- Adaptive square scanner frame (size set from ScannerHost.SizeChanged) -->
          <Border x:Name="ScannerFrame"
                  IsVisible="{Binding HasCameraPermission}"
                  HorizontalOptions="Center"
                  VerticalOptions="Center"
                  Background="Transparent"
                  Stroke="{DynamicResource Accent}"
                  StrokeThickness="2"
                  StrokeShape="RoundRectangle 10">
            <Grid x:Name="ScannerContent"
                  IsClippedToBounds="True">
              <zxing:CameraBarcodeReaderView x:Name="BarcodeReader"
                                             BarcodesDetected="OnBarcodesDetected"
                                             IsDetecting="{Binding IsScanning}"
                                             IsTorchOn="False"
                                             Opacity="{OnPlatform Android=1, WinUI=0, Default=0}"
                                             WidthRequest="{OnPlatform Android=-1, Default=1}"
                                             HeightRequest="{OnPlatform Android=-1, Default=1}"
                                             HorizontalOptions="{OnPlatform Android=Fill, Default=Start}"
                                             VerticalOptions="{OnPlatform Android=Fill, Default=Start}"
                                             InputTransparent="True" />

              <!-- Sample preview: title / QR+beam / caption — beam never overlaps caption -->
              <Grid IsVisible="{Binding ShowSamplePreview}"
                    Padding="16"
                    RowDefinitions="Auto,*,Auto"
                    RowSpacing="10">
                <Label Text="Пример QR-кода"
                       Style="{StaticResource SubtitleLabel}"
                       HorizontalTextAlignment="Center"
                       FontSize="13"
                       LineBreakMode="TailTruncation" />

                <Grid x:Name="QrScanArea"
                      Grid.Row="1"
                      HorizontalOptions="Center"
                      VerticalOptions="Center">
                  <Border BackgroundColor="#FFFFFF"
                          StrokeShape="RoundRectangle 10"
                          Padding="10"
                          HorizontalOptions="Fill"
                          VerticalOptions="Fill">
                    <Image x:Name="SampleQrImage"
                           Source="{Binding SampleQrCodeImage}"
                           Aspect="AspectFit"
                           HorizontalOptions="Fill"
                           VerticalOptions="Fill" />
                  </Border>

                  <Grid x:Name="SampleScanOverlay"
                        IsVisible="{Binding ShowScanAnimation}"
                        InputTransparent="True"
                        IsClippedToBounds="True">
                    <BoxView x:Name="SampleScanLine"
                             Background="{DynamicResource ScannerBeamBrush}"
                             HeightRequest="56"
                             HorizontalOptions="Fill"
                             VerticalOptions="Start"
                             Opacity="1"
                             InputTransparent="True" />
                  </Grid>
                </Grid>

                <Label Grid.Row="2"
                       Text="Наведите камеру на любой QR-код"
                       TextColor="{DynamicResource MutedText}"
                       FontSize="12"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap" />
              </Grid>

              <!-- Camera beam (Android): sweeps the full viewfinder -->
              <Grid x:Name="CameraScanOverlay"
                    IsVisible="{Binding ShowScanAnimation}"
                    InputTransparent="True"
                    IsClippedToBounds="True">
                <Grid.Triggers>
                  <DataTrigger TargetType="Grid"
                               Binding="{Binding ShowSamplePreview}"
                               Value="True">
                    <Setter Property="IsVisible" Value="False" />
                  </DataTrigger>
                </Grid.Triggers>
                <BoxView x:Name="CameraScanLine"
                         Background="{DynamicResource ScannerBeamBrush}"
                         HeightRequest="56"
                         HorizontalOptions="Fill"
                         VerticalOptions="Start"
                         Opacity="1"
                         InputTransparent="True" />
              </Grid>

              <Grid IsVisible="{Binding HasResult}"
                    BackgroundColor="#CC000000"
                    Padding="20">
                <VerticalStackLayout VerticalOptions="Center"
                                     HorizontalOptions="Fill"
                                     Spacing="16"
                                     MaximumWidthRequest="360">
                  <Label Text="Результат"
                         Style="{StaticResource HeaderLabel}"
                         FontSize="18"
                         HorizontalTextAlignment="Center" />

                  <Label Text="{Binding ScanResult}"
                         TextColor="{DynamicResource Accent}"
                         FontSize="15"
                         LineBreakMode="WordWrap"
                         HorizontalTextAlignment="Center">
                    <Label.GestureRecognizers>
                      <TapGestureRecognizer Command="{Binding OpenUrlCommand}" />
                    </Label.GestureRecognizers>
                    <Label.Triggers>
                      <DataTrigger TargetType="Label"
                                   Binding="{Binding IsUrl}"
                                   Value="False">
                        <Setter Property="TextColor" Value="{DynamicResource PrimaryText}" />
                      </DataTrigger>
                    </Label.Triggers>
                  </Label>

                  <Grid ColumnDefinitions="8*,2*"
                        ColumnSpacing="8"
                        HorizontalOptions="Fill">
                    <Button Grid.Column="0"
                            Text="Сканировать снова"
                            Style="{StaticResource SecondaryButton}"
                            HorizontalOptions="Fill"
                            Command="{Binding ResetScanCommand}" />

                    <Border Grid.Column="1"
                            Style="{StaticResource IconButton}"
                            BackgroundColor="{DynamicResource AccentSoft}"
                            WidthRequest="-1"
                            HeightRequest="-1"
                            MinimumHeightRequest="52"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill"
                            Padding="0">
                      <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CopyResultCommand}" />
                      </Border.GestureRecognizers>
                      <controls:SvgIconView IconName="{x:Static helpers:IconPaths.Copy}"
                                            IconColor="{DynamicResource Accent}"
                                            WidthRequest="22"
                                            HeightRequest="22"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center" />
                    </Border>
                  </Grid>
                </VerticalStackLayout>
              </Grid>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</ContentView>
