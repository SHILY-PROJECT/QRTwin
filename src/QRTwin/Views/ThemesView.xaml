<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:QRTwin.ViewModels"
             xmlns:controls="clr-namespace:QRTwin.Controls"
             xmlns:helpers="clr-namespace:QRTwin.Helpers"
             x:Class="QRTwin.Views.ThemesView"
             x:Name="ThemesViewRoot"
             x:DataType="vm:ThemesViewModel"
             HorizontalOptions="Fill"
             VerticalOptions="Fill">

  <ScrollView Orientation="Vertical"
              VerticalScrollBarVisibility="Default"
              HorizontalOptions="Fill"
              VerticalOptions="Fill">
    <VerticalStackLayout Spacing="12"
                         BindableLayout.ItemsSource="{Binding Themes}">
      <BindableLayout.ItemTemplate>
        <DataTemplate x:DataType="vm:ThemeOptionViewModel">
          <Border Padding="14"
                  Style="{StaticResource GlassOverlayItem}">
            <Border.Triggers>
              <DataTrigger TargetType="Border"
                           Binding="{Binding IsSelected}"
                           Value="True">
                <Setter Property="Stroke" Value="{DynamicResource Accent}" />
                <Setter Property="StrokeThickness" Value="2" />
              </DataTrigger>
            </Border.Triggers>

            <Border.GestureRecognizers>
              <TapGestureRecognizer Command="{Binding Source={x:Reference ThemesViewRoot}, Path=BindingContext.SelectThemeCommand}"
                                    CommandParameter="{Binding .}" />
            </Border.GestureRecognizers>

            <Grid ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="12">
              <Border Grid.Column="0"
                      WidthRequest="48"
                      HeightRequest="48"
                      StrokeShape="RoundRectangle 14"
                      Stroke="{DynamicResource Border}"
                      StrokeThickness="1"
                      Background="{Binding PreviewBrush}"
                      VerticalOptions="Center" />

              <VerticalStackLayout Grid.Column="1"
                                   Spacing="4"
                                   VerticalOptions="Center">
                <Label Text="{Binding Name}"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource PrimaryText}"
                       LineBreakMode="TailTruncation"
                       MaxLines="1" />
                <Label Text="{Binding Description}"
                       FontSize="13"
                       TextColor="{DynamicResource SecondaryText}"
                       LineBreakMode="WordWrap"
                       MaxLines="3" />
              </VerticalStackLayout>

              <controls:SvgIconView Grid.Column="2"
                                    IconName="{x:Static helpers:IconPaths.CheckmarkCircle}"
                                    IconColor="{DynamicResource Accent}"
                                    WidthRequest="24"
                                    HeightRequest="24"
                                    VerticalOptions="Center"
                                    HorizontalOptions="End"
                                    IsVisible="{Binding IsSelected}" />
            </Grid>
          </Border>
        </DataTemplate>
      </BindableLayout.ItemTemplate>
    </VerticalStackLayout>
  </ScrollView>
</ContentView>
