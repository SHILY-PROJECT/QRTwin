<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:QRTwin.ViewModels"
             xmlns:controls="clr-namespace:QRTwin.Controls"
             xmlns:helpers="clr-namespace:QRTwin.Helpers"
             xmlns:views="clr-namespace:QRTwin.Views"
             x:Class="QRTwin.Views.HistoryView"
             x:Name="HistoryViewRoot"
             x:DataType="vm:HistoryViewModel"
             HorizontalOptions="Fill"
             VerticalOptions="Fill">

  <Grid RowDefinitions="*,Auto">

    <Grid Grid.Row="0">
      <!-- ScrollView is edge-to-edge; item padding keeps content inset while scrollbar hugs the Border. -->
      <ScrollView IsVisible="{Binding HasEntries}"
                  VerticalOptions="Fill"
                  VerticalScrollBarVisibility="Default"
                  HorizontalScrollBarVisibility="Never">
        <VerticalStackLayout BindableLayout.ItemsSource="{Binding EntryItems}"
                             Spacing="8"
                             Padding="20,4,20,16">
          <BindableLayout.ItemTemplate>
            <DataTemplate x:DataType="vm:HistoryEntryItem">
              <views:HistoryEntryCard />
            </DataTemplate>
          </BindableLayout.ItemTemplate>
        </VerticalStackLayout>
      </ScrollView>

      <VerticalStackLayout IsVisible="{Binding ShowEmptyState}"
                           VerticalOptions="Center"
                           HorizontalOptions="Center"
                           Spacing="12"
                           Padding="24">
        <Border WidthRequest="64"
                HeightRequest="64"
                StrokeShape="RoundRectangle 10"
                BackgroundColor="{DynamicResource AccentSoft}">
          <controls:SvgIconView IconName="{x:Static helpers:IconPaths.History}"
                                IconColor="{DynamicResource Accent}"
                                WidthRequest="32"
                                HeightRequest="32"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
        </Border>
        <Label Text="История пуста"
               Style="{StaticResource HeaderLabel}"
               HorizontalTextAlignment="Center" />
        <Label Text="Сканируйте или создайте QR-код"
               Style="{StaticResource SubtitleLabel}"
               HorizontalTextAlignment="Center" />
      </VerticalStackLayout>
    </Grid>

    <Button Grid.Row="1"
            Text="Очистить всё"
            Style="{StaticResource SecondaryButton}"
            TextColor="{DynamicResource Danger}"
            Margin="20,8,20,20"
            IsVisible="{Binding HasEntries}"
            Command="{Binding ClearAllCommand}" />
  </Grid>
</ContentView>
